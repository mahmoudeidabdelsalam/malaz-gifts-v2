{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_ENV=production next build",
    "build:preview": "vite build",
    "dev:next": "NODE_ENV=development next dev --hostname 0.0.0.0",
    "preview": "vite preview",
    "format": "oxfmt",
    "verify": "tsc --noEmit && NODE_ENV=production next build && vite build"
  },
  "dependencies": {
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.7"
  }
}
